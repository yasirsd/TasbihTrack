# TasbihTrack — required environment variables
# Copy this file to .env.local for local development.
# Set the same variables in Vercel Project Settings for production.

# --- Database (server-side only, NEVER expose to browser) ---
# Prefer the Supabase pooled Postgres URL (region-pooler.supabase.com).
# The Vercel Supabase integration provides this as POSTGRES_URL.
POSTGRES_URL=

# Optional: separate non-pooled URL used for migrations if needed.
POSTGRES_URL_NON_POOLING=

# --- Session ---
# A 32+ byte random string used to derive session-token hashes.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- TLS certificate (optional) ---
# Preferred: place the Supabase CA at `certs/supabase-ca.crt` (see certs/README.md).
# Alternative: paste the full PEM (or its base64 encoding) here. On Vercel,
# multiline env values are supported.
# SUPABASE_CA_CERT=

# --- Optional runtime overrides ---
# NODE_ENV is set by the platform; don't set it manually in this file.
