{
  "name": "1011 Tracker",
  "short_name": "1011 Tracker",
  "description": "Track meaningful Dhikr goals, daily progress, and long-term journeys.",
  "start_url": "/app/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#09090B",
  "theme_color": "#09090B",
  "categories": ["lifestyle", "productivity"],
  "shortcuts": [
    {
      "name": "Open Dashboard",
      "short_name": "Home",
      "url": "/app/dashboard",
      "icons": [{ "src": "/icons/icon-v2-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Add Progress",
      "short_name": "Add",
      "url": "/app/dashboard?add=1",
      "icons": [{ "src": "/icons/icon-v2-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-v2-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-v2-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-v2-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
