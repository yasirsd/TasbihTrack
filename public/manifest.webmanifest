{
  "name": "TasbihTrack",
  "short_name": "TasbihTrack",
  "description": "Set a goal. Track the journey.",
  "start_url": "/app/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#09090B",
  "theme_color": "#09090B",
  "categories": ["lifestyle", "productivity"],
  "shortcuts": [
    {
      "name": "Open Dashboard",
      "short_name": "Home",
      "url": "/app/dashboard",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Add Progress",
      "short_name": "Add",
      "url": "/app/dashboard?add=1",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
